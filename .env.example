# OpenDots — copy to .env.local and adjust.

# Storage: memory (default, resets on restart) or postgres.
DATA_STORE=postgres
DATABASE_URL=postgres://opendots:opendots@localhost:5432/opendots
# Local without Docker on this Mac: postgres://opendots@127.0.0.1:5439/opendots

# Brain: Claude on your subscription via the local `claude` login. No API key.
# On a host without a keychain login (Docker, VM) run `claude setup-token` once and set:
# CLAUDE_CODE_OAUTH_TOKEN=
# Force the planner's dry-run answer (no model call). The eval sets this itself.
# BRAIN_DRY_RUN=1
CLAUDE_MODEL=sonnet
BOT_MAX_TURNS=12
# BOT_MAX_BUDGET_USD=1.00
OPENDOTS_WORKSPACES_DIR=./.opendots/workspaces

# Knowledge search: memory (lexical) today; pgvector returns once local embeddings land.
RAG_VECTOR_STORE=memory
RAG_TOP_K=4
RAG_MIN_SCORE=0.05

DEPLOYMENT_SESSION_SECRET=dev-only-change-me

# The bot's screen: requires `npm i -g agent-browser` on PATH.
AGENT_BROWSER_BIN=agent-browser
# Bot browser window size, "WxH".
OPENDOTS_BROWSER_VIEWPORT=1280x800
# Captured-frame JPEG quality, 1-100; lower is smaller/faster, higher is sharper.
OPENDOTS_SCREENSHOT_QUALITY=70
# Per-command timeout for each agent-browser call; browser_open gets 2x this.
OPENDOTS_BROWSER_TIMEOUT_MS=30000
